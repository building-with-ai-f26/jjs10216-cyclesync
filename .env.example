# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# OpenRouter (AI). Leave the key blank to use mock AI mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Set to "mock" to force the sample recommendation even when a key is set.
AI_MODE=

# PostHog (public project key, same project as the Product Page)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Local server port
PORT=3000
