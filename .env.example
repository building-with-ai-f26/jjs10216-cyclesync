# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# OpenRouter (AI). Leave the key blank to use mock AI mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Set to "mock" to force the sample recommendation even when a key is set.
AI_MODE=

# PostHog (public project key, same project as the Product Page)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Supabase (live database). Only for `npm run test:security` on the laptop:
# the project URL and the PUBLISHABLE key (public by design).
# The SECRET key (sb_secret_...) goes ONLY in Vercel → Settings → Environment
# Variables, never here. Without it, the app uses data/cyclesync-db.json.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Live site address, used only by `npm run invite` to print invite links
APP_URL=

# Local server port
PORT=3000
